    classDef normalStyle fill:#f0f4c3,stroke:#afb42b,stroke-width:1px;
    class PendingPayment, Paid, Shipped, PendingAudit normalStyle
    classDef finalStyle fill:#ffebee,stroke:#e53935,stroke-width:2px;
    class Completed, Cancelled finalStyle