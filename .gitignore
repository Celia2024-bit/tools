# Python bytecode
__pycache__/
*.pyc

# trace_injector writes one log per run, into whatever directory it ran from
trace_injector_*.log

#
# Generated by parameters_check/generate_parameter_check.py. ParameterCheck.h is
# rendered against one specific Types.h and CheckTraits.h is copied next to that
# Types.h, so both are output of a build step, not source. Checking either one in
# is how you end up with a header generated for somebody else's types.
#
parameters_check/test/output/
parameters_check/test/include/CheckTraits.h
trace_injector/test/include/CheckTraits.h
trace_injector/test/include/ParameterCheck.h

# Built and written by the parameters_check test program
parameters_check/test/test_runner
parameters_check/test/test_runner.exe
parameters_check/test/parameter_check.log
